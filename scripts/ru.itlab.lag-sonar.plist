<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ru.itlab.lag-sonar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>lag_sonar</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Перезапускать, если процесс упадёт: индикатор бесполезен, когда его нет. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Не молотить перезапусками, если падение systematic. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/lag-sonar.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/lag-sonar.err.log</string>
</dict>
</plist>
